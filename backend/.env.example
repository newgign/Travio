PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=travel

# Optional staging connection. Takes precedence over DB_* when nonempty.
DATABASE_URL=
# Empty: verify-full for DATABASE_URL, disable for local DB_*.
DB_SSL_MODE=
DB_SSL_CA_PATH=

JWT_SECRET=generate_a_long_random_secret
JWT_EXPIRES_IN=7d

# Short-lived signed provider offer passed through the booking funnel.
# If empty, JWT_SECRET is used.
OFFER_TOKEN_SECRET=
OFFER_TOKEN_EXPIRES_IN=20m

CORS_ORIGIN=http://localhost:5173
# Optional comma-separated origins; when defined takes precedence over CORS_ORIGIN.
# CORS_ORIGINS=https://your-frontend.example

# mock remains the safe default until Hotelbeds mTLS is configured.
ACTIVE_PROVIDER=mock

# Explicit TEST/LIVE selection. LIVE never inherits legacy TEST secrets.
HOTELBEDS_ENV=
HOTELBEDS_ENABLED=false
HOTELBEDS_BOOKING_ENABLED=false
HOTELBEDS_LIVE_BOOKING_ENABLED=false
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
HOTELBEDS_LIVE_API_KEY=
HOTELBEDS_LIVE_API_SECRET=
HOTELBEDS_TIMEOUT_MS=12000
HOTELBEDS_BOOKING_TIMEOUT_MS=65000
HOTELBEDS_REQUEST_INTERVAL_MS=300
HOTELBEDS_READ_RETRIES=2
HOTELBEDS_MTLS_CERT_PATH=
HOTELBEDS_MTLS_KEY_PATH=
HOTELBEDS_MTLS_KEY_PASSPHRASE=
HOTELBEDS_MTLS_CA_PATH=
HOTELBEDS_LIVE_MTLS_CERT_PATH=
HOTELBEDS_LIVE_MTLS_KEY_PATH=
HOTELBEDS_LIVE_MTLS_KEY_PASSPHRASE=
HOTELBEDS_LIVE_MTLS_CA_PATH=
# Owner must choose the minimum verified discount. Empty disables public hot deals.
HOT_DEAL_MIN_DISCOUNT_PERCENT=
HOT_DEALS_MONITOR_ENABLED=false
HOT_DEALS_MONITOR_INTERVAL_MS=900000
HOT_DEALS_MONITOR_MAX_SEARCHES=5

# Checkout offer snapshot lifetime. A Hotelbeds rateKey should be used quickly.
CHECKOUT_SESSION_TTL_MINUTES=20

# Optional smoke-test values
HOTELBEDS_TEST_HOTEL_CODES=3424,168
HOTELBEDS_TEST_CHECKIN=
HOTELBEDS_TEST_NIGHTS=1
HOTELBEDS_TEST_ADULTS=2
HOTELBEDS_TEST_AUTO_CANCEL=true

# Hotelbeds Content API local catalog sync
HOTELBEDS_CONTENT_LANGUAGE=ENG
HOTELBEDS_SYNC_COUNTRIES=EG,TR,AE,TH
HOTELBEDS_SYNC_HOTELS_PER_DESTINATION=100


# Sprint 2H email notifications.
# Safe default is disabled. Set EMAIL_ENABLED=true only after choosing a provider.
# console = logs a simulated delivery locally (no external message).
# resend = sends a real email through Resend HTTP API.
EMAIL_ENABLED=false
EMAIL_PROVIDER=console
EMAIL_FROM=Travio <bookings@example.com>
RESEND_API_KEY=

# Sprint 2H payment gateway preparation.
# disabled = payment intents are blocked.
# sandbox = local sandbox intent only; no real charge.
PAYMENTS_MODE=disabled
PAYMENTS_PROVIDER=none

# Sprint 2K/2L pre-production hardening.
# These flags are intentionally NOT allowed to enable real-money operations in Sprint 2N.
PRODUCTION_SALES_ENABLED=false
REAL_CHARGES_ENABLED=false
REAL_REFUNDS_ENABLED=false

# Requests slower than this threshold are recorded in system_events.
SYSTEM_SLOW_REQUEST_MS=1500

# Sprint 2L/2M/2N deployment safety / operations.
# Health probes bypass rate limiting. All values below are safe defaults for local development.
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
SHUTDOWN_GRACE_MS=10000

# Database backups are local filesystem artifacts and can contain password hashes and personal data.
# For real environments set an encryption key and require encryption.
DB_BACKUP_DIR=./backups
DB_BACKUP_RETENTION=10
DB_BACKUP_ENCRYPTION_KEY=
DB_BACKUP_REQUIRE_ENCRYPTION=false

# Restore is dry-run by default. Set true only inside a controlled maintenance window.
ALLOW_DATABASE_RESTORE=false

# Sprint 2M/2N automated operations / observability baseline.
# Auto backup is OFF by default. Enable only after choosing a protected backup location.
DB_BACKUP_AUTO_ENABLED=false
DB_BACKUP_AUTO_INTERVAL_MS=86400000
DB_BACKUP_AUTO_RUN_ON_START=false
# Optional age-based cleanup in addition to DB_BACKUP_RETENTION. 0 disables age cleanup.
DB_BACKUP_MAX_AGE_DAYS=0

# Lightweight health monitoring. It writes a system event only when DB health changes.
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL_MS=60000

# Logger: pretty for local development, json for production log collectors.
LOG_FORMAT=pretty
HTTP_ACCESS_LOG=false

# Sprint 2N reliability & alerting.
# This monitor is read-only for bookings/payments; it only writes reliability snapshots and incident lifecycle records.
RELIABILITY_MONITOR_ENABLED=true
RELIABILITY_MONITOR_INTERVAL_MS=60000
RELIABILITY_HISTORY_RETENTION_DAYS=7

# API 5xx alert thresholds over the in-memory 5-minute metrics window.
RELIABILITY_API_MIN_REQUESTS=10
RELIABILITY_API_DEGRADED_5XX_PCT=2
RELIABILITY_API_UNHEALTHY_5XX_PCT=10

# Backup freshness thresholds. Scheduler may remain disabled in development if manual backups are current.
RELIABILITY_BACKUP_WARN_HOURS=36
RELIABILITY_BACKUP_CRITICAL_HOURS=72

# Outbox alert thresholds (failed + stuck queued messages in the last 24 hours).
RELIABILITY_EMAIL_FAILED_WARN=1
RELIABILITY_EMAIL_FAILED_CRITICAL=5

# Hotelbeds alerting uses recent local provider/system errors; it does not create extra external booking traffic.
RELIABILITY_HOTELBEDS_ERROR_WINDOW_MIN=15
RELIABILITY_HOTELBEDS_WARN_ERRORS=1
RELIABILITY_HOTELBEDS_CRITICAL_ERRORS=5

# Daily incremental catalog sync, disabled by default. Initial sync is manual.
HOTELBEDS_CONTENT_SYNC_ENABLED=false
